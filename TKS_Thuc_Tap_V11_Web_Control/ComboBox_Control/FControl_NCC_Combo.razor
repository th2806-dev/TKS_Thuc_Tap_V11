@inherits FBase_Combo;

<TelerikMultiColumnComboBox @bind-Value="@BindingValue"
                            ScrollMode="@DropDownScrollMode.Virtual"
                            Data="@m_arrData"
                            ValueField="@(nameof(CDM_Nha_Cung_Cap.Auto_ID))"
                            TextField="@(nameof(CDM_Nha_Cung_Cap.Ten_NCC))"
                            Width="100%"
                            PageSize="10"
                            ItemHeight="35"
                            Filterable="true"
                            FilterOperator="@StringFilterOperator.Contains"
                            ListHeight="260px">
    <MultiColumnComboBoxColumns>
        <MultiColumnComboBoxColumn Field="@nameof(CDM_Nha_Cung_Cap.Ma_NCC)" Title="@Get_Language_Data_Field("Mã NCC")" Width="150px" Class="k-tks-combobox-item" HeaderClass="k-tks-combobox-header" />
        <MultiColumnComboBoxColumn Field="@nameof(CDM_Nha_Cung_Cap.Ten_NCC)" Title="@Get_Language_Data_Field("Tên NCC")" Width="250px" Class="k-tks-combobox-item" HeaderClass="k-tks-combobox-header" />
    </MultiColumnComboBoxColumns>
</TelerikMultiColumnComboBox>

@code {
    List<CDM_Nha_Cung_Cap> m_arrData = new();

    protected override void Load_Data()
    {
        m_arrData = CCache_Nha_Cung_Cap.List_Data();
        CDM_Nha_Cung_Cap v_objAll = new();
        v_objAll.Auto_ID = -5;
        v_objAll.Ma_NCC = "Tất Cả";
        v_objAll.Ten_NCC = "Tất Cả";
        m_arrData.Insert(0, v_objAll);
    }
}
