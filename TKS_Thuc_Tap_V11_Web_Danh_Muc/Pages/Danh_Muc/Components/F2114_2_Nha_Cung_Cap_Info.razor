@inherits FBase

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <ul class="nav nav-pills card-header-pills" role="tablist">
                    <li class="nav-item" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#thongtin_ncc" role="tab">
                            @Get_Language_Data_Field("Thông tin")
                        </a>
                    </li>
                    <li class="nav-item" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#history_ncc" role="tab">
                            @Get_Language_Data_Field("Lịch sử xử lý")
                        </a>
                    </li>
                </ul>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Modal_Cancel"></button>
            </div>

            @((MarkupString)r_strError)

            <div class="modal-body">
                <div class="tab-content">
                    <div class="tab-pane active show" id="thongtin_ncc" role="tabpanel">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("ID")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Auto_ID, true)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Mã nhà cung cấp")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Ma_NCC, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Tên nhà cung cấp")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Ten_NCC, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Ghi chú")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Ghi_Chu, false)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Ngày giờ tạo")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Created, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Người tạo")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Chức năng tạo")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Created_By_Function, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Ngày giờ cập nhật sau cùng")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Người cập nhật sau cùng")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By, false)</span>
                                    </div>
                                </div>
                                <div class="row mb-3">
                                    <div class="col-lg-11">
                                        <label class="form-label-info">@Get_Language_Data_Field("Chức năng cập nhật sau cùng")</label><br />
                                        <span class="form-label">@CUtility.Get_Label_Text(m_objData.Last_Updated_By_Function, false)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane" id="history_ncc" role="tabpanel">
                        <FCommon_Record_Action_History_List v_arrData="@m_arrRAH" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_Nha_Cung_Cap m_objData = new();
    private List<CLog_Record_Action_History> m_arrRAH = new();

    protected override void Load_Data()
    {
        var v_objController = new CDM_Nha_Cung_Cap_Controller();
        m_objData = v_objController.FQ_114_NCC_sp_sel_Get_By_ID(r_iAuto_ID)
            ?? new CDM_Nha_Cung_Cap();

        var v_objHistoryController = new CLog_Record_Action_History_Controller();
        m_arrRAH = v_objHistoryController.FCommon_Sys_sp_sel_List_Log_Record_Action_History(r_iAuto_ID);
    }
}
