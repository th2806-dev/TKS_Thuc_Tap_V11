@inherits FBase

@Layout_Default_Filter(m_grdData, "")

<div class="row" style="padding-top: 10px;">
    <div class="col-lg-12">
        @((MarkupString)r_strError)

        <TelerikGrid Data="@m_arrData" Height="calc(100vh - 170px)" Resizable="true" Reorderable="true" @ref="@m_grdData">
            <GridExport>
                <GridExcelExport FileName="San_Pham_Export" AllPages="true" />
                <GridCsvExport FileName="San_Pham_Export" AllPages="true" />
            </GridExport>
            <GridColumns>
                <GridCheckboxColumn SelectAll="true" CheckBoxOnlySelection="true" Width="30px" />
                <GridColumn Width="60px">
                    <Template>
                        @{
                            var v_objData = context as CDM_San_Pham;
                        }
                        <button type="button" class="btn btn-link" title="Xem" @onclick="@(() => Open_Info(v_objData.Auto_ID))">
                            <i class="mdi mdi-eye" style="color: purple;"></i>
                        </button>
                        <button type="button" class="btn btn-link" data-bs-toggle="dropdown" aria-expanded="false" title="Thao tác">
                            <i class="mdi mdi-cog-outline" style="color: purple;"></i>
                        </button>
                        <ul class="dropdown-menu">
                            @if (r_objChuc_Nang.Is_Have_Edit_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Open_Edit(v_objData.Auto_ID))">
                                        <i class="ri-edit-2-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Hiệu chỉnh")
                                    </button>
                                </li>
                            }
                            @if (r_objChuc_Nang.Is_Have_Delete_Permission)
                            {
                                <li>
                                    <button class="dropdown-item" type="button" @onclick="@(() => Delete_Data(v_objData.Auto_ID))">
                                        <i class="ri-delete-bin-line align-bottom me-1"></i> &nbsp; @Get_Language_Data_Field("Xóa")
                                    </button>
                                </li>
                            }
                        </ul>
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(CDM_San_Pham.Auto_ID)" Title="ID" Width="100px" />
                <GridColumn Field="@nameof(CDM_San_Pham.Ma_San_Pham)" Title="Mã sản phẩm" Width="150px" />
                <GridColumn Field="@nameof(CDM_San_Pham.Ten_San_Pham)" Title="Tên sản phẩm" Width="250px" />
                <GridColumn Field="@nameof(CDM_San_Pham.Ten_Loai_San_Pham)" Title="Loại sản phẩm" Width="180px" />
                <GridColumn Field="@nameof(CDM_San_Pham.Ten_Don_Vi_Tinh)" Title="Đơn vị tính" Width="130px" />
                <GridColumn Field="@nameof(CDM_San_Pham.Ghi_Chu)" Title="Ghi chú" />
            </GridColumns>
        </TelerikGrid>
    </div>
</div>

@if (r_bIs_Show_Info)
{
    <F2113_2_San_Pham_Info r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Info" />
}

@if (r_bIs_Show_Help_Guide)
{
    <FCommon_Help_Guide m_strFCode="@r_strActive_Function_Code" OnClose="@Close_Helpguide" />
}

@if (r_bIs_Show_Edit)
{
    <F2113_3_San_Pham_Edit r_iAuto_ID="@r_iAuto_ID" OnClose="@Close_Edit" />
}


@code {
    private List<CDM_San_Pham> m_arrData = new();
    private TelerikGrid<CDM_San_Pham> m_grdData = new();

    protected override void Init_Data()
    {

    }

    protected override void Load_Data()
    {
        Format_Grid(m_grdData);
        CDM_San_Pham_Controller v_objCtrData = new();
        m_arrData = v_objCtrData.FQ_113_SP_sp_sel_List_By_Created(r_objFilter.Date_From, r_objFilter.Date_To);
    }

    protected override void Delete_Data_Entry(long p_iAuto_ID)
    {
        CDM_San_Pham_Controller v_objCtrData = new();

        // Đoạn code lưu key cho việc tracking log CRUD, vui lòng đừng xóa
        CDM_San_Pham v_objData = v_objCtrData.FQ_113_SP_sp_sel_Get_By_ID(p_iAuto_ID);
        if (v_objData == null)
            throw new Exception("Sản phẩm không còn tồn tại hoặc đã bị xóa.");

        r_strDelete_Key = v_objData.Ma_San_Pham;
        // End tracking

        v_objCtrData.FQ_113_SP_sp_del_Delete_By_ID(p_iAuto_ID, r_strActive_User_Name, r_strActive_Function_Code);
        CCache_San_Pham.Delete_Data(p_iAuto_ID);
    }
}
