@inherits FBase

<div class="modal fade show" tabindex="-1" role="dialog" aria-hidden="true" style="display: block; background-color: rgba(10, 10, 10, .8);">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title">
                    @Get_Language_Data_Field(r_iAuto_ID == 0 ? "Thêm kho" : "Hiệu chỉnh kho")
                </h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="Modal_Cancel"></button>
            </div>
            @((MarkupString)r_strError)
            <EditForm Model="@m_objData">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@Get_Language_Data_Field("Tên kho"):</label>
                        <input @ref="txtFocus" @bind="m_objData.Ten_Kho" class="form-control" maxlength="400" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Get_Language_Data_Field("Ghi chú"):</label>
                        <textarea @bind="m_objData.Ghi_Chu" class="form-control" maxlength="500" rows="3"></textarea>
                    </div>
                </div>
            </EditForm>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" @onclick="Save_Data">
                    @Get_Language_Data_Field("Lưu Thay Đổi")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private CDM_Kho m_objData = new();

    protected override void Load_Data()
    {
        if (r_iAuto_ID == 0)
            return;

        var v_objController = new CDM_Kho_Controller();
        m_objData = v_objController.FQ_115_Kho_sp_sel_Get_By_ID(r_iAuto_ID)
            ?? throw new InvalidOperationException("Kho không còn tồn tại hoặc đã bị xóa.");
        if (!CCommonFunction.Is_User_Allowed_Kho(r_strActive_User_Name, m_objData.Auto_ID))
            throw new UnauthorizedAccessException("Bạn không được phân quyền thao tác với kho này.");

        r_bUpdate = true;
        var v_objSource = new CDM_Kho();
        CUtility.Clone_Entity(m_objData, v_objSource);
        r_objSource = v_objSource;
    }

    protected override void Add_Data()
    {
        Check_Data();
        m_objData.Last_Updated_By = r_strActive_User_Name;
        m_objData.Last_Updated_By_Function = r_strActive_Function_Code;

        var v_objController = new CDM_Kho_Controller();
        m_objData.Auto_ID = r_iAuto_ID = v_objController.FQ_115_Kho_sp_ins_Insert(m_objData);
        r_strAdd_Key = m_objData.Ten_Kho;
        CCache_Kho.Add_Data(m_objData);
    }

    protected override void Update_Data()
    {
        Check_Data();
        m_objData.Last_Updated_By = r_strActive_User_Name;
        m_objData.Last_Updated_By_Function = r_strActive_Function_Code;

        var v_objController = new CDM_Kho_Controller();
        if (!v_objController.FQ_115_Kho_sp_upd_Update(m_objData))
            throw new InvalidOperationException("Không thể cập nhật kho.");

        var v_objDes = new CDM_Kho();
        CUtility.Clone_Entity(m_objData, v_objDes);
        r_objDes = v_objDes;
        CCache_Kho.Update_Data(m_objData);
    }

    private void Check_Data()
    {
        if (r_iAuto_ID == 0 && !CCommonFunction.Is_User_In_Kho_Admin_Group(r_strActive_User_Name))
            throw new UnauthorizedAccessException("Chỉ thành viên nhóm Quản trị được tạo kho mới.");
        if (r_iAuto_ID > 0 && !CCommonFunction.Is_User_Allowed_Kho(r_strActive_User_Name, r_iAuto_ID))
            throw new UnauthorizedAccessException("Bạn không được phân quyền thao tác với kho này.");
        if (string.IsNullOrWhiteSpace(m_objData.Ten_Kho))
            throw new InvalidOperationException("Tên kho không được để trống.");
    }
}
